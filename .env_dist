# Copia este archivo a .env y rellena los valores.
# Genera el secreto de cookies de Bokeh con:
#   openssl rand -hex 32
BOKEH_COOKIE_SECRET=

# LDAP/AD (autenticación)
# URIs LDAP/LDAPS separadas por comas (o una lista JSON)
PANELAPP_LDAP_DOMAIN=
PANELAPP_LDAP_URIS=
# upn | netbios (si se deja vacío se deduce)
PANELAPP_LDAP_LOGIN_FORMAT=upn
# Solo necesario con login_format=netbios
PANELAPP_LDAP_NETBIOS_NAME=
# true | false (recomendado: true)
PANELAPP_LDAP_ENCRYPT_CONNECTIONS=true
