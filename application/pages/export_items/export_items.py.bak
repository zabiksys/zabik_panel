FEATURE_PROFILE = 'PRODUCTO'

def custom_field(
        en: str, es: str,
        formatter: dict | None = None,
        ) -> field:
    metadata = {'title': {'en': en, 'es': es}}
    if formatter:
        metadata['formatter'] = formatter
    return field(default=None, metadata=metadata)


class CrossRefType(Enum):
    CUSTOMER = 1
    VENDOR = 2
    BARCODE = 3


class UOMState(Enum):
    _ = 0
    INVENTED = 1
    EXPECTED = 2
    VERIFIED = 3
    SHIPMARKS = 4


@dataclass
class Title:
    en: str
    es: str


