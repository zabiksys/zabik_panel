def get_expanded_fields(field_names: list[str], locale: str) -> list[tuple[str, str]]:
    result = []
    for field_name, field_info in ItemModel.model_fields.items():
        if field_name in field_names:
            expandable = None
            for metadata in field_info.metadata:
                if isinstance(metadata, Title):
                    title = getattr(metadata, locale)
                if isinstance(metadata, FeatureQuestions):
                    expandable = [(f'{field_name}.question_{q.line_no_}', q.description) for q in metadata.questions]
            if expandable:
                result += expandble
            else:
                result.append((field_name, title))
                
    return result
        
    
def get_field_value(item: ItemModel, field_name: str) -> Any:
    if '.' in field_name:
        parts = field_name.split('.')
        field_value = getattr(item, parts[0])

        pass
    else:
        return getattr(item, field_name)


def get_field_title(field_name: str, locale: str) -> str:
    for metadata in ItemModel.model_fields.get(field_name).metadata:
        if isinstance(metadata, Title):
            return getattr(metadata, locale, None)


def get_field_formatter(field_name: str) -> dict | None:
    for metadata in ItemModel.model_fields.get(field_name).metadata:
        if isinstance(metadata, Origin):
            return getattr(metadata, 'formatter', None)


def get_field_feature_questions() -> FeatureQuestions | None:
    for metadata in ItemModel.model_fields['features'].metadata:
        if isinstance(metadata, FeatureQuestions):
            return metadata
    

def set_field_feature_questions(feature_questions: FeatureQuestions) -> None:
    ItemModel.model_fields['features'].metadata.append(feature_questions)


def get_items(engine, nav_company, *, use_fields: list[str], conditions: list[str], params: dict[str, str]) -> Iterator[ItemModel]:
    column_list: list[str] = []
    process: dict[str, Callable] = {}
    for field_name in use_fields:
        field_info = ItemModel.model_fields.get(field_name)
        for metadata in field_info.metadata:
            if isinstance(metadata, Origin):
                column_list += metadata.column_list
                if hasattr(metadata, 'process'):
                    process[field_name] = metadata.process
                
    dependency_cols = set(column_list)
    where = ' AND '.join(conditions) if conditions else '1=1'
    sql = text(f"""
        SELECT
            {', '.join(dependency_cols)}
        FROM [{nav_company}$Item] item
        WHERE {where}
        ORDER BY item.[Report Order]
    """)
    with Session(engine) as session:
        for row in session.execute(sql, params):
            item_data = {}
            for field_name in use_fields:
                val = process[field_name](session, nav_company, row)
                item_data = {**item_data, field_name: val}
            yield ItemModel(**item_data)
