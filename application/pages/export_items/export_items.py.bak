class FeatureDataType(Enum):
    INTEGER = 0
    DECIMAL = 1
    TEXT = 2
    DATE = 3
    BOOLEAN = 4
    OPTION = 5


@dataclass
class Feature:
    title: str
    value: Any


@dataclass
class FeatureAnswer:
    description: str
    line_no_: int


@dataclass
class FeatureQuestion:
    description: str
    line_no_: int
    multiple_answers: bool
    data_type: FeatureDataType
    answers: list[FeatureAnswer]


@dataclass
class ExtendedText:
    code: str


def uom_state_mapper(x, locale):
    return {
        UOMState._: {'en': '', 'es': ''},
        UOMState.EXPECTED: {'en': 'Expected', 'es': 'Previsto'},
        UOMState.INVENTED: {'en': 'Invented', 'es': 'Inventado'},
        UOMState.SHIPMARKS: {'en': 'Shipmarks', 'es': 'Shipmarks'},
        UOMState.VERIFIED: {'en': 'Verified', 'es': 'Verificado'}
        }[x][locale]


@dataclass
class Origin:
    process: Callable[[Session, Row], Any]
    formatter: dict | None = None
    column_list: list[str] = field(default_factory=list)


@dataclass
class FeatureQuestions:
    questions: OrderedDict[int, FeatureQuestion]


def get_feature_questions(session, nav_company: str) -> OrderedDict[int, FeatureQuestion]:
    sql = text(f"""SELECT feat.Type type,
            feat.Description description,
            feat.[Line No_] line_no_,
            feat.[Multiple Answers] multiple_answers,
            feat.[Data Type] data_type
        FROM [{nav_company}$Feature] feat
        WHERE
            feat.[Profile Code] = :profile_code
        ORDER BY feat.[Line No_]""")
    feature_questions: list[tuple[int, FeatureQuestion]] = []
    for row in session.execute(sql, {'profile_code': FEATURE_PROFILE}):
        if row.type == 0:  # question
            feature_questions.append((row.line_no_, FeatureQuestion(
                line_no_=row.line_no_,
                description=row.description,
                multiple_answers=row.multiple_answers,
                answers=[],
                data_type=FeatureDataType(row.data_type))))
        elif row.type == 1:  # answer
            feature_questions[-1][1].answers.append(
                FeatureAnswer(description=row.description, line_no_=row.line_no_))
    return OrderedDict(feature_questions)


def get_feature_questionnaire(session, nav_company: str, item: Row) -> list[Feature]:
    if not (questions := get_field_feature_questions()):
        questions=FeatureQuestions(questions=get_feature_questions(session, nav_company))
        set_field_feature_questions(questions)
        
    sql = text(f"""SELECT
        [Line No_] line_no_,
        [Data Type] data_type,
        [Feature Integer] feature_integer,
        [Feature Decimal] feature_decimal,
        [Feature Text] feature_text,
        [Feature Date] feature_date,
        [Feature Boolean] feature_boolean
    FROM [{nav_company}$Feature Questionnaire]
    WHERE [Profile Code] = :profile_code
        AND No_ = :item_no_
    ORDER BY [Line No_]""")
    questionnaire: list[Feature] = []
    for row in session.execute(sql, {'profile_code': FEATURE_PROFILE, 'item_no_': item.no_}):
        print('row', row)
        data_type = FeatureDataType(row.data_type)
        if data_type == FeatureDataType.OPTION:
            pass
        else:
            match data_type:
                case FeatureDataType.BOOLEAN:
                    value = row.feature_boolean
                case FeatureDataType.DATE:
                    value = row.feature_date
                case FeatureDataType.DECIMAL:
                    value = float(row.feature_decimal)
                case FeatureDataType.INTEGER:
                    value = row.feature_integer
                case FeatureDataType.TEXT:
                    value = row.feature_text
            questionnaire.append(
                Feature(title=questions.questions[row.line_no_].description, value=value))
    return questionnaire


